# Copy this file to .env and change the values.

# Password for the Admin page. Required: the server will not start without it.
ADMIN_PASSWORD=change-me

# Port the app listens on.
PORT=8080

# Time everyone's place and status are cleared each morning (24-hour HH:MM).
RESET_AT=05:00

# Time zone used for RESET_AT. Docker uses UTC unless this is set.
TZ=Asia/Ho_Chi_Minh
