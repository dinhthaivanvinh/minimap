// Cloudflare Workers settings. See "Deploy to Cloudflare" in README.md.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "team-minimap",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  // The built pages. Run `npm run build` first; `npm run deploy` does both.
  "assets": { "directory": "./dist", "binding": "ASSETS" },
  // One Durable Object holds the team's data and the live connections.
  "durable_objects": { "bindings": [{ "name": "MINIMAP", "class_name": "Minimap" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Minimap"] }],
  // ADMIN_PASSWORD is a secret: set it with `npx wrangler secret put ADMIN_PASSWORD`.
  "vars": {
    "RESET_AT": "05:00",
    "TZ": "Asia/Ho_Chi_Minh"
  },
  "observability": { "enabled": true }
}
